<UserControl
    x:Class="Tabulation.UI.AdminManagement.Views.AddCriteriaWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Templates="clr-namespace:Templates.CustomMessageBox.Views;assembly=Templates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Tabulation.UI.AdminManagement.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Width="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="white"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\MaterialDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="Icon" Value="{x:Null}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <materialDesign:DialogHost Identifier="{Binding DialogGuid}">
        <GroupBox
            Margin="4"
            materialDesign:ShadowAssist.Darken="True"
            BorderThickness="0"
            Style="{DynamicResource MaterialDesignGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock Text="Add Criteria" />
                    </DockPanel>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Templates:CustomTextbox HintText="Criteria Name" Icon="Label" />
                    <Templates:CustomTextbox
                        Width="120"
                        Margin="10,0"
                        HorizontalAlignment="Right"
                        HintText="Percentage"
                        Icon="PercentSharp" />
                </DockPanel>
                <GroupBox
                    Grid.Row="1"
                    Header="Criterions"
                    Style="{x:Null}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Templates:AddRefreshButtons Grid.Row="0" AddCommand="{Binding AddCriterion}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Padding="2,10,2,10" ItemsSource="{Binding CriterionListInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Templates:CustomTextbox
                                                HintText="Criterion Name"
                                                Icon="Label"
                                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Templates:CustomTextbox
                                                Width="120"
                                                HorizontalAlignment="Right"
                                                HintText="Percentage"
                                                Icon="Percent"
                                                Text="{Binding Percentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button
                                                Width="50"
                                                Margin="0"
                                                Padding="0"
                                                Command="{Binding RemoveCriterion}"
                                                CommandParameter="{Binding}"
                                                Foreground="OrangeRed"
                                                Style="{StaticResource MaterialDesignFlatButton}">
                                                <Button.Content>
                                                    <iconPacks:PackIconMaterialDesign
                                                        Width="17"
                                                        Height="17"
                                                        Kind="Delete" />
                                                </Button.Content>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <DockPanel Grid.Row="2" HorizontalAlignment="Right">
                            <Button Command="{Binding Save}" Style="{StaticResource MaterialDesignFlatDarkButton}">
                                <Button.Content>

                                    <DockPanel>
                                        <icon:PackIconMaterialDesign Kind="Save" />
                                        <TextBlock Text="Save" />
                                    </DockPanel>
                                </Button.Content>
                            </Button>
                            <Button
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                                Foreground="OrangeRed"
                                Style="{StaticResource MaterialDesignFlatButton}">
                                <Button.Content>
                                    <DockPanel>
                                        <icon:PackIconMaterialDesign Kind="AssignmentReturn" />
                                        <TextBlock Text="Cancel" />
                                    </DockPanel>
                                </Button.Content>
                            </Button>
                        </DockPanel>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </materialDesign:DialogHost>
</UserControl>
