<Controls:MetroContentControl
    x:Class="Tabulation.UI.AdminManagement.Views.AddCandidateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:Templates="clr-namespace:Templates.CustomMessageBox.Views;assembly=Templates"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Tabulation.UI.AdminManagement.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:regionNames="clr-namespace:Helpers;assembly=Helpers"
    Width="1000"
    Height="700"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    mc:Ignorable="d">
    <Controls:MetroContentControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\MaterialDesign.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Controls:MetroContentControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="ShowInTaskbar" Value="False" />
            <Setter Property="Icon" Value="{x:Null}" />
        </Style>
    </prism:Dialog.WindowStyle>
    <GroupBox
        Margin="4"
        materialDesign:ShadowAssist.Darken="True"
        BorderThickness="0"
        Style="{DynamicResource MaterialDesignGroupBox}">
        <GroupBox.HeaderTemplate>
            <DataTemplate>
                <DockPanel>
                    <icon:PackIconMaterialDesign Kind="AddCircle" />
                    <TextBlock Text="Candidate Profile" />
                </DockPanel>
            </DataTemplate>
        </GroupBox.HeaderTemplate>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Grid.Column="0"
                    Width="160"
                    Height="160"
                    Margin="12,0,20,0"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="200">
                    <Grid>
                        <Button
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignFloatingActionButton}" />
                    </Grid>
                </Border>
                <Templates:CustomTextbox
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="auto"
                    HorizontalContentAlignment="Left"
                    HintText="First Name" />
                <Templates:CustomTextbox
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    HintText="Middle Name" />
                <Templates:CustomTextbox
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalContentAlignment="Left"
                    HintText="Last Name" />
                <DatePicker
                    Grid.Row="3"
                    Grid.Column="1"
                    Style="{StaticResource MaterialDesignFilledDatePicker}" />
            </Grid>
        </Grid>
    </GroupBox>
</Controls:MetroContentControl>
